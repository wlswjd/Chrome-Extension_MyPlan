{
  "manifest_version": 3,
  "name": "My Plan - Daily Planner",
  "version": "0.1.0",
  "description": "파스텔 블루 데일리 플래너",
  "icons": {
    "16": "MyPlan_icon.png",
    "32": "MyPlan_icon.png",
    "48": "MyPlan_icon.png",
    "128": "MyPlan_icon.png"
  },
  "action": {
    "default_title": "My Plan",
    "default_popup": "index.html",
    "default_icon": {
      "16": "MyPlan_icon.png",
      "32": "MyPlan_icon.png",
      "48": "MyPlan_icon.png",
      "128": "MyPlan_icon.png"
    }
  },
  "permissions": ["storage"]
}
