{
  "manifest_version": 3,
  "name": "My Plan - Daily Planner",
  "version": "1.0.1",
  "description": "파스텔 블루 데일리 플래너 (Google Calendar & Tasks 연동 지원)",
  "icons": {
    "16": "MyPlan_icon.png",
    "32": "MyPlan_icon.png",
    "48": "MyPlan_icon.png",
    "128": "MyPlan_icon.png"
  },
  "action": {
    "default_title": "My Plan",
    "default_popup": "index.html",
    "default_icon": {
      "16": "MyPlan_icon.png",
      "32": "MyPlan_icon.png",
      "48": "MyPlan_icon.png",
      "128": "MyPlan_icon.png"
    }
  },
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://tasks.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "361625898849-q26bk8vkgtghucrbn9g314l1qpms622g.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/userinfo.email",
      "https://www.googleapis.com/auth/userinfo.profile",
      "https://www.googleapis.com/auth/calendar.events",
      "https://www.googleapis.com/auth/tasks"
    ]
  }
}
